<UserControl x:Class="CRM_Master.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18,24,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Report" Style="{StaticResource Text.H2}"/>
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Title" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SelectedType.Description}" Style="{StaticResource Text.Caption}" Margin="0,6,0,16"/>

                    <TextBlock Text="Date range" Style="{StaticResource Text.Label}"/>
                    <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label"/>
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="From (yyyy-MM-dd)" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="To (yyyy-MM-dd)" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>

                    <TextBlock Text="Contact category" Style="{StaticResource Text.Label}" Margin="0,14,0,4"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
                    <TextBlock Text="Applies to duplicate, data-quality and invalid-record reports." Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>

                    <TextBlock Text="Processing status" Style="{StaticResource Text.Label}" Margin="0,14,0,4"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label"/>
                    <TextBlock Text="Applies to import, bulk-update, automation and audit reports." Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>

                    <StackPanel Visibility="{Binding ShowBatch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Batch id (optional)" Style="{StaticResource Text.Label}" Margin="0,14,0,4"/>
                        <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Limit to one operation - the batch id is shown in Activity Logs"/>
                    </StackPanel>

                    <Button Content="Preview report" Style="{StaticResource Button.Primary}" Command="{Binding PreviewCommand}" Margin="0,20,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Export to Excel (.xlsx)" Command="{Binding ExportCommand}" CommandParameter="Excel" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Export to CSV (.csv)" Command="{Binding ExportCommand}" CommandParameter="Csv" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Export to PDF (.pdf)" Command="{Binding ExportCommand}" CommandParameter="Pdf" Margin="0" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="PDF uses basic Latin text. Use Excel or CSV for other scripts." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Border Style="{StaticResource Card}" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Reports}" Style="{StaticResource Icon}" Width="40" Height="40" Stroke="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="Choose a report and press Preview" Style="{StaticResource Text.H2}" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reports are built from your local data and can be saved as Excel, CSV or PDF." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedType.Title}" Style="{StaticResource Text.H2}"/>
                        <ItemsControl ItemsSource="{Binding Summary}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Margin="0,2"><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=":  "/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Table}" AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoGeneratingColumn" BorderThickness="0" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Grid.Row="1" Text="{Binding PreviewNote}" Style="{StaticResource Text.Caption}" Margin="14,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
