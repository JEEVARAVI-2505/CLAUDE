<UserControl x:Class="CRM_Master.App.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.BorderStrong}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EmailState}" Value="Valid"><Setter Property="Fill" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding EmailState}" Value="Invalid"><Setter Property="Fill" Value="{DynamicResource Brush.Error}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhoneDot" TargetType="Ellipse" BasedOn="{StaticResource StateDot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PhoneState}" Value="Valid"><Setter Property="Fill" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding PhoneState}" Value="Invalid"><Setter Property="Fill" Value="{DynamicResource Brush.Error}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add contact" Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}"/>
                <Button Content="Delete selected" Style="{StaticResource Button.Danger}" Command="{Binding DeleteSelectedCommand}"/>
                <Button x:Name="ExportButton" Content="Export  v" Click="OnExportClick" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Excel (.xlsx)" Command="{Binding ExportCommand}" CommandParameter="Excel"/>
                            <MenuItem Header="CSV (.csv)" Command="{Binding ExportCommand}" CommandParameter="Csv"/>
                            <MenuItem Header="PDF (.pdf)" Command="{Binding ExportCommand}" CommandParameter="Pdf"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBlock Text="Search, filter and manage every contact. Tick rows for bulk actions; double-click a row to open its profile." Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" ToolTip="Search name, email, phone, company, city or job title"/>
                <TextBlock Text="Search name, email, phone, company, city..." IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Search, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0"/>
            </Grid>
        </Border>

        <!-- grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Sorting="OnSorting" BorderThickness="0" Background="Transparent">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ViewCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="View profile" Command="{Binding PlacementTarget.DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Edit" Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="0" ToolTip="Select all on this page"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="FullName" Width="1.3*"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" SortMemberPath="Company" Width="1.2*"/>
                        <DataGridTemplateColumn Header="Email" SortMemberPath="Email" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource StateDot}"/><TextBlock Text="{Binding Email}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Phone" SortMemberPath="Phone" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource PhoneDot}"/><TextBlock Text="{Binding Phone}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="City" Binding="{Binding City}" SortMemberPath="City" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="0.8*"/>
                        <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="1.1*" CanUserSort="False"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, Converter={StaticResource UtcToLocal}, ConverterParameter='dd MMM yyyy'}" SortMemberPath="UpdatedAt" Width="0.9*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                    <Path Data="{StaticResource Icon.Contacts}" Style="{StaticResource Icon}" Width="40" Height="40" Stroke="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="No contacts to show" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="Import a file, add a contact, or clear the filters." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- pager -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="|&lt;" Command="{Binding FirstPageCommand}" ToolTip="First page" Padding="10,6"/>
                <Button Content="&lt; Previous" Command="{Binding PreviousPageCommand}"/>
                <Button Content="Next &gt;" Command="{Binding NextPageCommand}"/>
                <Button Content="&gt;|" Command="{Binding LastPageCommand}" ToolTip="Last page" Padding="10,6" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBlock Text="{Binding SelectedCount, StringFormat='   -   {0} selected'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Secondary}" Visibility="{Binding SelectedCount, Converter={StaticResource CountToVis}}"/>
        </DockPanel>
    </Grid>
</UserControl>
