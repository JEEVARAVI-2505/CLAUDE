<Window x:Class="CRM_Master.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CRM_Master.App.Services"
        Title="CRM MASTER - Intelligent CRM Data Management &amp; Automation Suite" Icon="/Assets/app.ico"
        Width="1380" Height="860" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}" FontFamily="{StaticResource Font.Default}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="10,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Height="42">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{Binding Icon}" Style="{StaticResource Icon}" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{TemplateBinding Foreground}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarActive}"/><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SidebarActive}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Sidebar" Width="248" Background="{DynamicResource Brush.Sidebar}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel x:Name="BrandText" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CRM MASTER" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Data Automation Suite" Foreground="{DynamicResource Brush.SidebarMuted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Title}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding AppVersion}" Foreground="{DynamicResource Brush.SidebarMuted}" FontSize="11" Margin="20,0,0,16"/>
            </Grid>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleSidebarCommand}" ToolTip="Collapse / expand menu" Padding="8" MinHeight="0">
                            <Path Data="{StaticResource Icon.Menu}" Style="{StaticResource Icon}" Stroke="{DynamicResource Brush.TextSecondary}"/>
                        </Button>
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.H1}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusPill}" ToolTip="Status of the local SQLite database">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Success}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DatabaseStatusText}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusPill}" ToolTip="All processing happens on this computer">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Local processing: " FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <TextBlock Text="{Binding ProcessingText}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleNotificationsCommand}" ToolTip="Notifications" Padding="9" MinHeight="0" Margin="0">
                                <Path Data="{StaticResource Icon.Bell}" Style="{StaticResource Icon}" Stroke="{DynamicResource Brush.TextSecondary}"/>
                            </Button>
                            <Border Background="{DynamicResource Brush.Error}" CornerRadius="8" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False"
                                    Visibility="{Binding Notifications.UnreadCount, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding Notifications.UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                            <Popup IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" HorizontalOffset="-300" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Style="{StaticResource Card}" Width="360" MaxHeight="420" Margin="8,6,16,16" Padding="0">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/></Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="16,12">
                                            <TextBlock Text="Notifications" Style="{StaticResource Text.H2}"/>
                                            <Button Content="Clear" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Command="{Binding ClearNotificationsCommand}" Margin="0"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="No notifications yet." Style="{StaticResource Text.Caption}" Margin="16,0,16,16" Visibility="{Binding Notifications.Items.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Notifications.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10">
                                                            <StackPanel>
                                                                <DockPanel><TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
                                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="ProfileButton" Style="{StaticResource Button.Ghost}" Click="OnProfileClick" Padding="8,4" MinHeight="0" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.Primary}">
                                    <Path Data="{StaticResource Icon.Contacts}" Style="{StaticResource Icon}" Width="16" Height="16" Stroke="{DynamicResource Brush.OnPrimary}"/>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Settings" Command="{Binding NavigateCommand}" CommandParameter="{x:Static svc:Module.Settings}"/>
                                    <MenuItem Header="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"/>
                                    <MenuItem Header="About CRM MASTER" Command="{Binding NavigateCommand}" CommandParameter="{x:Static svc:Module.About}"/>
                                    <Separator/>
                                    <MenuItem Header="Exit" Command="{Binding ExitAppCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Visibility="{Binding LicenseBanner, Converter={StaticResource NullToVis}}" Margin="16,12,16,0">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner.Info}">
                    <Style.Triggers><DataTrigger Binding="{Binding IsLicenseExpired}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <DockPanel>
                    <Button Content="Licence details" Style="{StaticResource Button.Link}" DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="{x:Static svc:Module.About}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding LicenseBanner}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ModuleHost" Grid.Row="2" Content="{Binding Current}" Margin="0" IsTabStop="False"/>
        </Grid>
    </Grid>
</Window>
