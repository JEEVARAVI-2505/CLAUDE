<Window x:Class="CRM_Master.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to CRM MASTER" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" FontFamily="{StaticResource Font.Default}" Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="32,28">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app.png" Width="48" Height="48"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome to CRM MASTER" Style="{StaticResource Text.H1}"/>
                    <TextBlock Text="Let's set up your workspace. You can change all of this later in Settings." Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="Your name" Style="{StaticResource Text.Label}"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                    <TextBlock Text="Default phone country code (without +)" Style="{StaticResource Text.Label}"/>
                    <TextBox Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Text="Used for numbers written without a country prefix. 91 = India." Style="{StaticResource Text.Caption}" Margin="0,4,0,14"/>
                    <CheckBox Content="Use dark theme" IsChecked="{Binding UseDarkTheme}" Margin="0,0,0,10"/>
                    <CheckBox Content="Load a small sample dataset (fictional contacts) so I can try the features" IsChecked="{Binding LoadSample}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Banner.Info}" Margin="0,14,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12.5">
                    <Run FontWeight="SemiBold">Your data stays on this computer.</Run>
                    <Run Text="CRM MASTER stores everything in a local database under your Windows profile and sends nothing to the internet."/>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding DataFolder, StringFormat='Database folder: {0}'}" Style="{StaticResource Text.Caption}" Margin="2,10,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Error}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Exit" IsCancel="True"/>
                <Button Content="Get started" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnStart" Margin="0" Padding="22,8"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
