<UserControl x:Class="CRM_Master.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CRM_Master.App.Controls"
             xmlns:svc="clr-namespace:CRM_Master.App.Services">
    <UserControl.Resources>
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Big}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="good"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ImportRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding ImportedRows, Mode=OneWay}"/><Run Text=" imported - "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StartedAt, Converter={StaticResource UtcToLocal}, ConverterParameter='dd MMM HH:mm'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LogRow">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Timestamp, Converter={StaticResource UtcToLocal}, ConverterParameter='dd MMM HH:mm'}" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">
            <!-- empty state -->
            <Border Style="{StaticResource Card}" Padding="32" Margin="0,0,0,18" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.InfoBg}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Database}" Style="{StaticResource Icon}" Width="30" Height="30" Stroke="{DynamicResource Brush.Info}"/>
                    </Border>
                    <TextBlock Text="Your CRM database is empty" Style="{StaticResource Text.H1}" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                    <TextBlock Text="Import a spreadsheet or add a contact. These figures are calculated live from your local database - nothing here is placeholder data."
                               Style="{StaticResource Text.Caption}" TextAlignment="Center" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Import data" Style="{StaticResource Button.Primary}" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Import}"/>
                        <Button Content="Add a contact" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Contacts}" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- quick actions -->
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Quick actions" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Import data" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Import}"/>
                    <Button Content="Find duplicates" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Duplicates}"/>
                    <Button Content="Clean data" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Cleaning}"/>
                    <Button Content="Add contact" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Contacts}"/>
                    <Button Content="Reports" Command="{Binding GoCommand}" CommandParameter="{x:Static svc:Module.Reports}"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource KpiValue}"/>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Contact growth" Style="{StaticResource Text.H2}"/>
                        <TextBlock Text="Total contacts at the end of each month (last 12 months)" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <ctl:LineChart Height="230" Points="{Binding Growth}" LineBrush="{DynamicResource Brush.Secondary}" GridBrush="{DynamicResource Brush.Border}" TextBrush="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Data quality" Style="{StaticResource Text.H2}"/>
                        <TextBlock Text="Records by quality status" Style="{StaticResource Text.Caption}" Margin="0,0,0,12"/>
                        <ctl:BarChart Items="{Binding Quality}" TextBrush="{DynamicResource Brush.TextSecondary}" TrackBrush="{DynamicResource Brush.Hover}"
                                      GoodBrush="{DynamicResource Brush.Success}" WarnBrush="{DynamicResource Brush.Warning}" BadBrush="{DynamicResource Brush.Error}" InfoBrush="{DynamicResource Brush.Info}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Recent import history" Style="{StaticResource Text.H2}" Margin="0,0,0,6"/>
                        <TextBlock Text="No imports yet." Style="{StaticResource Text.Caption}" Visibility="{Binding RecentImports.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding RecentImports}" ItemTemplate="{StaticResource ImportRow}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Recent automation activity" Style="{StaticResource Text.H2}" Margin="0,0,0,6"/>
                        <TextBlock Text="No rules have run yet." Style="{StaticResource Text.Caption}" Visibility="{Binding RecentAutomation.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding RecentAutomation}" ItemTemplate="{StaticResource LogRow}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recent errors" Style="{StaticResource Text.H2}" Margin="0,0,0,6"/>
                        <TextBlock Text="No errors recorded." Style="{StaticResource Text.Caption}" Visibility="{Binding RecentErrors.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding RecentErrors}" ItemTemplate="{StaticResource LogRow}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
