<UserControl x:Class="CRM_Master.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,6"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="conflict"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="match"><Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="fill"><Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClassBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Class}" Value="Exact"><Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Class}" Value="High"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/></DataTrigger>
                <DataTrigger Binding="{Binding Class}" Value="Possible"><Setter Property="Background" Value="{DynamicResource Brush.InfoBg}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Scan for duplicates" Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}"/>
                        <Button Content="Cancel" Command="{Binding CancelScanCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Merge all exact" Command="{Binding MergeAllExactCommand}" ToolTip="Only groups classified Exact are merged"/>
                        <Button x:Name="ExportBtn" Content="Export report  v" Click="OnExportClick" Margin="0">
                            <Button.ContextMenu><ContextMenu>
                                <MenuItem Header="Excel (.xlsx)" Command="{Binding ExportReportCommand}" CommandParameter="Excel"/>
                                <MenuItem Header="CSV (.csv)" Command="{Binding ExportReportCommand}" CommandParameter="Csv"/>
                                <MenuItem Header="PDF (.pdf)" Command="{Binding ExportReportCommand}" CommandParameter="Pdf"/>
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <CheckBox Content="Email" IsChecked="{Binding MatchEmail}"/><CheckBox Content="Phone" IsChecked="{Binding MatchPhone}"/>
                        <CheckBox Content="Name" IsChecked="{Binding MatchName}"/><CheckBox Content="Company" IsChecked="{Binding MatchCompany}"/>
                        <CheckBox Content="Fuzzy name matching" IsChecked="{Binding UseFuzzy}"/>
                    </WrapPanel>
                </DockPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding HighThreshold, StringFormat='High-confidence threshold: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding HighThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding PossibleThreshold, StringFormat='Possible threshold: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding PossibleThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding LowThreshold, StringFormat='Low-confidence threshold: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding LowThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding ProgressText, Converter={StaticResource NullToVis}}" Margin="0,8,0,0"><ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"/><TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/></StackPanel>
                <TextBlock Text="{Binding ScanNote}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="{Binding ScanNote, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- groups -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource Text.Caption}" Margin="4,0,0,8"/>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8">
                                    <DockPanel><Border Style="{StaticResource ClassBadge}" DockPanel.Dock="Right"><TextBlock Text="{Binding Class}" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"><Run Text="{Binding TopScore, StringFormat='Score {0:0.00}', Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Contacts.Count, Mode=OneWay, StringFormat='{}{0} records'}"/></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="No duplicate groups. Run a scan to look for them." Style="{StaticResource Text.Caption}" Margin="6,8" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="&gt;" Command="{Binding NextPageCommand}" Padding="10,4" MinHeight="0" Margin="4,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="&lt;" Command="{Binding PreviousPageCommand}" Padding="10,4" MinHeight="0" Margin="0"/>
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- comparison -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Path Data="{StaticResource Icon.Duplicates}" Style="{StaticResource Icon}" Width="36" Height="36" Stroke="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Text="Select a group to compare its records" Style="{StaticResource Text.H2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Compare records side by side" Style="{StaticResource Text.H2}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Grid.Row="1" Margin="0,2,0,8">
                            <Run Text="Green = same value."/><Run Text=" Amber = conflicting values - pick which to keep."/><Run Text=" Blue = only one record has a value."/><Run Text=" Choose the master record; untick a record to leave it out of the merge."/>
                        </TextBlock>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding GroupContacts}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SubHeader}" Style="{StaticResource Text.Caption}"/>
                                                        <RadioButton GroupName="master" Content="Master record" IsChecked="{Binding IsMaster}" Margin="0,6,0,0"/>
                                                        <CheckBox Content="Include in merge" IsChecked="{Binding Include}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="2" Text="Value to keep" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FieldRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RowBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="10,2" TextWrapping="Wrap" MaxHeight="64"/></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding HasChoices}" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Merge selected fields" Style="{StaticResource Button.Primary}" Command="{Binding MergeCommand}"/>
                            <Button Content="Skip for now" Command="{Binding SkipCommand}"/>
                            <Button Content="Mark as separate customers" Command="{Binding MarkSeparateCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
