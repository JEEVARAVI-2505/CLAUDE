<UserControl x:Class="CRM_Master.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/app.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource Text.Big}"/>
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Caption}" FontSize="13"/>
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,14">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner.Info}"><Style.Triggers><DataTrigger Binding="{Binding LicenseExpired}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel><TextBlock Text="Licence status" FontWeight="SemiBold"/><TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Licence" Style="{StaticResource Text.H2}"/><TextBlock Text="{Binding LicenceText}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <TextBlock Text="Developer" Style="{StaticResource Text.H2}"/><TextBlock Text="{Binding Developer}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <TextBlock Text="Support" Style="{StaticResource Text.H2}"/><TextBlock Text="{Binding Support}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Your data and privacy" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="Everything is stored and processed locally. CRM MASTER has no telemetry and does not send contact data anywhere. Email checks are syntax-only and never contact mail servers." TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <TextBlock Text="{Binding DataFolder, StringFormat='Data folder: {0}'}" Style="{StaticResource Text.Caption}"/>
                    <TextBlock Text="{Binding LogsFolder, StringFormat='Log folder: {0}'}" Style="{StaticResource Text.Caption}"/>
                    <TextBlock Text="{Binding Runtime, StringFormat='Runtime: {0}'}" Style="{StaticResource Text.Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Open data folder" Command="{Binding OpenDataCommand}"/><Button Content="Open log folder" Command="{Binding OpenLogsCommand}" Margin="0"/></StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Third-party software notices" Style="{StaticResource Text.H2}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Notices, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
