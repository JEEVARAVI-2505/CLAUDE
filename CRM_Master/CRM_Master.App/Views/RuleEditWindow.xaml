<Window x:Class="CRM_Master.App.Views.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CRM_Master.App.ViewModels"
        Title="Automation rule" Width="800" Height="740" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" FontFamily="{StaticResource Font.Default}" Foreground="{DynamicResource Brush.Text}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,14"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Rule name" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <TextBlock Text="Description (optional)" Style="{StaticResource Text.Label}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <CheckBox Content="Rule is enabled" IsChecked="{Binding IsEnabled}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Trigger - when should the rule run?" Style="{StaticResource Text.H2}"/>
                        <ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding Trigger}" Margin="0,8,0,0" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TriggerHelp}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add condition" Command="{Binding AddConditionCommand}" Margin="0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Conditions - only if" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Matches}" SelectedItem="{Binding Match}" Width="90" Margin="10,0,0,0"/>
                                <TextBlock Text="of these are true" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="No conditions: the rule applies to every contact." Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="{Binding Conditions.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Conditions}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{x:Static vm:ConditionRow.Fields}" SelectedItem="{Binding Field}" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ConditionRow.Operators}" SelectedItem="{Binding Operator}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}"/>
                                        <Button Grid.Column="3" Content="Remove" Style="{StaticResource Button.Link}" Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add action" Command="{Binding AddActionCommand}" Margin="0"/>
                            <TextBlock Text="Actions - then do this" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{x:Static vm:ActionRow.Types}" SelectedItem="{Binding Type}" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ActionRow.Fields}" SelectedItem="{Binding Field}" Margin="0,0,8,0" Visibility="{Binding NeedsField, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}"/>
                                        <Button Grid.Column="3" Content="Remove" Style="{StaticResource Button.Link}" Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save rule" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
