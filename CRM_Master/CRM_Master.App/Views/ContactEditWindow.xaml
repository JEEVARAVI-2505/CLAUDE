<Window x:Class="CRM_Master.App.Views.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact" Width="860" Height="760" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}" FontFamily="{StaticResource Font.Default}" Foreground="{DynamicResource Brush.Text}" Icon="/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="Field" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,12,12"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Brush.Primary}" Margin="0,0,14,0">
                    <Path Data="{StaticResource Icon.Contacts}" Style="{StaticResource Icon}" Width="22" Height="22" Stroke="{DynamicResource Brush.OnPrimary}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="Created "/><Run Text="{Binding CreatedText, Mode=OneWay}"/><Run Text="   -   Last updated "/><Run Text="{Binding UpdatedText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="24,8,24,0">
            <TabItem Header="Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Personal information" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="First name" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.FirstName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Last name" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.LastName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Full name" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.FullName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Company information" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Company" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.CompanyName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Job title" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.JobTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Website" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.Website, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Contact details" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Email" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Phone" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Alternate phone" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.AlternatePhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="City" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.City, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="State" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.State, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Country" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.Country, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Address" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding Model.Address, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Lead information" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Lead source" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Model.LeadSource, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Contact status" Style="{StaticResource Text.Label}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Model.Status}" IsEnabled="{Binding CanEdit}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Text="Created date (yyyy-MM-dd)" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding CreatedDateText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding ImportInfo}" Style="{StaticResource Text.Caption}" Visibility="{Binding ImportInfo, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Notes" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Model.Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Custom fields" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                                <TextBlock Text="No custom fields yet." Style="{StaticResource Text.Caption}" Visibility="{Binding CustomFields.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                                <ItemsControl ItemsSource="{Binding CustomFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" ToolTip="Name of a new custom field"/>
                                    <Button Content="Add custom field" Command="{Binding AddCustomFieldCommand}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Activity history">
                <Grid>
                    <TextBlock Text="No recorded activity yet." Style="{StaticResource Text.Caption}" Margin="4,12" Visibility="{Binding History.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    <DataGrid ItemsSource="{Binding History}" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}}" Width="140"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="130"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTextColumn Header="Previous" Binding="{Binding PreviousValue}" Width="1.2*"/>
                            <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Edit" Command="{Binding StartEditCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Close" Command="{Binding CloseCommand}" Margin="0" IsCancel="True"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
