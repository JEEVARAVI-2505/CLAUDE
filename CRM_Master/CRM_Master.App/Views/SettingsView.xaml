<UserControl x:Class="CRM_Master.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28" MaxWidth="1100" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Application theme" Style="{StaticResource Text.Label}"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Your name (shown in the top bar)" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="Rows per page in contact lists" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding PageSize, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Default phone country code (no +)" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Folders and database" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Backup folder" Style="{StaticResource Text.Label}"/>
                    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseBackupFolderCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <TextBlock Text="Default export folder" Style="{StaticResource Text.Label}"/>
                    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseExportFolderCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding ExportFolder, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <TextBlock Text="Database file" Style="{StaticResource Text.Label}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Change location..." Command="{Binding ChangeDatabaseLocationCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding DatabaseFile, Mode=OneWay}" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="Your data lives under your Windows profile (not the installation folder), so updates and uninstalling the program never touch it." Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Duplicate matching thresholds" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="A pair scoring at or above a threshold gets that class. They must increase: low &lt; possible &lt; high." Style="{StaticResource Text.Caption}" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding LowThreshold, StringFormat='Low confidence: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding LowThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding PossibleThreshold, StringFormat='Possible duplicate: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding PossibleThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding HighThreshold, StringFormat='High confidence: {0:0.00}'}" Style="{StaticResource Text.Label}"/><Slider Minimum="0.5" Maximum="1" Value="{Binding HighThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Default validation rules" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="A contact missing any required field is classed as incomplete." Style="{StaticResource Text.Caption}" Margin="0,2,0,10"/>
                    <WrapPanel>
                        <TextBlock Text="Required:" VerticalAlignment="Center" Margin="0,0,12,8" FontWeight="SemiBold"/>
                        <CheckBox Content="Name" IsChecked="{Binding ReqName}" Margin="0,0,16,8"/><CheckBox Content="Email" IsChecked="{Binding ReqEmail}" Margin="0,0,16,8"/>
                        <CheckBox Content="Phone" IsChecked="{Binding ReqPhone}" Margin="0,0,16,8"/><CheckBox Content="Company" IsChecked="{Binding ReqCompany}" Margin="0,0,16,8"/>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox Content="Validate website addresses" IsChecked="{Binding ValidateWebsite}" Margin="0,0,20,0"/><CheckBox Content="Validate country names / codes" IsChecked="{Binding ValidateCountry}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Import, automation and logs" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="When an imported row matches an existing contact" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding PolicyOptions}" SelectedItem="{Binding SelectedPolicy}" DisplayMemberPath="Label" Margin="0,0,0,10"/>
                            <CheckBox Content="Tidy data while importing" IsChecked="{Binding CleanOnImport}" Margin="0,0,0,8"/>
                            <CheckBox Content="Run automation rules" IsChecked="{Binding AutomationEnabled}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Keep activity-log entries for (days)" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <CheckBox Content="Back up automatically before bulk operations" IsChecked="{Binding AutoBackup}" Margin="0,0,0,8"/>
                            <TextBlock Text="Automatic backups to keep" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding BackupsToKeep, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Save settings" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Padding="24,8"/>
                <TextBlock Text="{Binding SavedMessage}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Back up now" Style="{StaticResource Button.Primary}" Command="{Binding BackupNowCommand}"/>
                            <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding HasSelectedBackup}"/>
                            <Button Content="Restore from file..." Command="{Binding RestoreFromFileCommand}"/>
                            <Button Content="Open folder" Command="{Binding OpenBackupFolderCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Backup and restore" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Backups are consistent snapshots of the whole database. Restoring always keeps a safety copy of your current data." Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                    <TextBlock Text="No backups yet." Style="{StaticResource Text.Caption}" Visibility="{Binding Backups.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" SelectionMode="Single" MaxHeight="240" Visibility="{Binding Backups.Count, Converter={StaticResource CountToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, Converter={StaticResource UtcToLocal}}" Width="1.2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*"/>
                            <DataGridTextColumn Header="Contacts" Binding="{Binding ContactCount}" Width="0.7*"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CRM integrations" Style="{StaticResource Text.H2}"/>
                    <Border Style="{StaticResource Banner.Warning}" Margin="0,8,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5"><Run FontWeight="SemiBold">Not connected to any real CRM.</Run><Run Text=" Version 1.0 only contains development mock adapters; they never contact HubSpot, Zoho CRM, Salesforce or Pipedrive and do not synchronise real data. Genuine OAuth connectors using the vendors' official APIs are planned. Every local feature works without them."/></TextBlock>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Connectors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0"><TextBlock Text="{Binding Maturity}" FontSize="11" FontWeight="SemiBold"/></Border>
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"/></StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
