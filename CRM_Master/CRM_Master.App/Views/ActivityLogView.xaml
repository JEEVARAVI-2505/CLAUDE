<UserControl x:Class="CRM_Master.App.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Clear" Command="{Binding ClearCommand}"/>
                    <Button Content="Export Excel" Command="{Binding ExportCommand}" CommandParameter="Excel"/>
                    <Button Content="Export CSV" Command="{Binding ExportCommand}" CommandParameter="Csv" Margin="0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Search the summary, previous / new values and errors"/>
                    <TextBlock Text="Search activity..." IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Search, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" DisplayMemberPath="Label" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4" Text="{Binding RecordIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Show only entries for this record id"/>
                    <TextBlock Grid.Column="4" Text="Record id" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding RecordIdText, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}, ConverterParameter='dd MMM yyyy HH:mm:ss'}" Width="150"/>
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="150"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource StatusCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Record" Binding="{Binding RecordId}" Width="70"/>
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select an entry to see its details" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEntry.Operation}" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding SelectedEntry.Summary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                            <TextBlock Text="Status" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding SelectedEntry.Status}" Margin="0,0,0,10"/>
                            <TextBlock Text="Batch id" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding SelectedEntry.BatchId}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Previous value" Style="{StaticResource Text.Label}"/>
                            <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,10"><TextBlock Text="{Binding SelectedEntry.PreviousValue}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></Border>
                            <TextBlock Text="New value" Style="{StaticResource Text.Label}"/>
                            <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,10"><TextBlock Text="{Binding SelectedEntry.NewValue}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></Border>
                            <StackPanel Visibility="{Binding SelectedEntry.ErrorDetails, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="Error details" Style="{StaticResource Text.Label}"/>
                                <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,10"><TextBlock Text="{Binding SelectedEntry.ErrorDetails}" TextWrapping="Wrap" FontSize="12"/></Border>
                            </StackPanel>
                            <Button Content="Undo this whole operation" Command="{Binding UndoBatchCommand}" IsEnabled="{Binding CanUndoBatch}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Delete old entries" Command="{Binding PurgeOldCommand}"/>
                <Button Content="&lt; Previous" Command="{Binding PreviousPageCommand}"/>
                <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
        </DockPanel>
    </Grid>
</UserControl>
