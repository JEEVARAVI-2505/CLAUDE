<UserControl x:Class="CRM_Master.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CRM_Master.App.Views">
    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Invalid"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DuplicateExisting"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DuplicateInFile"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CountTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="MinWidth" Value="120"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,28">

            <!-- 1. file -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="1. Choose a file" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="Supported: Excel (.xlsx, .xlsm) and CSV. Column names do not have to match - you map them in step 3. Macros in .xlsm files are never run." Style="{StaticResource Text.Caption}" Margin="0,2,0,10"/>
                    <Grid x:Name="DropZone" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave" Background="Transparent" MinHeight="96">
                        <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" Stroke="{DynamicResource Brush.BorderStrong}" StrokeDashArray="4 3" StrokeThickness="1.5" Fill="{DynamicResource Brush.SurfaceAlt}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon.Import}" Style="{StaticResource Icon}" Stroke="{DynamicResource Brush.Secondary}" Width="22" Height="22" Margin="0,0,10,0"/>
                                <TextBlock Text="Drag and drop a file here, or" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <Button Content="Browse..." Style="{StaticResource Button.Primary}" Command="{Binding BrowseCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FileInfoText}" HorizontalAlignment="Center" Margin="0,8,0,0" FontWeight="SemiBold" Visibility="{Binding FileInfoText, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasSheets, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Worksheet:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheet}" Width="240"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                <!-- 2. file preview -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. File preview" Style="{StaticResource Text.H2}"/>
                        <TextBlock Text="The first rows exactly as they appear in your file." Style="{StaticResource Text.Caption}" Margin="0,2,0,8"/>
                        <DataGrid ItemsSource="{Binding FilePreview}" AutoGenerateColumns="True" MaxHeight="260" HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- 3. mapping -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Re-detect columns" Command="{Binding ResetMappingCommand}" Margin="0"/>
                            <TextBlock Text="3. Map your columns" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Columns were matched automatically using names, similar spellings and the data itself. Check them and change anything that is wrong. Choose 'Custom field' to keep extra columns." Style="{StaticResource Text.Caption}" Margin="0,2,0,10"/>
                        <v:MappingGrid/>
                        <Border Style="{StaticResource Banner.Error}" Margin="0,10,0,0" Visibility="{Binding MappingErrors.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl ItemsSource="{Binding MappingErrors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. options + dry run -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="4. Options and preview" Style="{StaticResource Text.H2}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="When a row matches an existing contact (same email or phone)" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{Binding PolicyOptions}" SelectedItem="{Binding SelectedPolicy}" DisplayMemberPath="Label"/>
                                <TextBlock Text="{Binding SelectedPolicy.Description}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data cleaning" Style="{StaticResource Text.Label}"/>
                                <CheckBox Content="Tidy names, emails, phone numbers and websites while importing" IsChecked="{Binding CleanOnImport}"/>
                                <TextBlock Text="Nothing is deleted - original values stay in your file." Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Check file (dry run)" Command="{Binding PreviewImportCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>

                        <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                            <WrapPanel>
                                <Border Style="{StaticResource CountTile}"><StackPanel><TextBlock Text="Ready to import" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Preview.Ready}" Style="{StaticResource Text.Big}" Foreground="{DynamicResource Brush.Success}"/></StackPanel></Border>
                                <Border Style="{StaticResource CountTile}"><StackPanel><TextBlock Text="With warnings" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Preview.Warnings}" Style="{StaticResource Text.Big}" Foreground="{DynamicResource Brush.Warning}"/></StackPanel></Border>
                                <Border Style="{StaticResource CountTile}"><StackPanel><TextBlock Text="Already in CRM" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Preview.DuplicateExisting}" Style="{StaticResource Text.Big}"/></StackPanel></Border>
                                <Border Style="{StaticResource CountTile}"><StackPanel><TextBlock Text="Repeated in file" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Preview.DuplicateInFile}" Style="{StaticResource Text.Big}"/></StackPanel></Border>
                                <Border Style="{StaticResource CountTile}"><StackPanel><TextBlock Text="Cannot import" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Preview.Invalid}" Style="{StaticResource Text.Big}" Foreground="{DynamicResource Brush.Error}"/></StackPanel></Border>
                            </WrapPanel>
                            <TextBlock Text="Preview of the first rows (how they will look after import)" Style="{StaticResource Text.Label}" Margin="0,10,0,6"/>
                            <DataGrid ItemsSource="{Binding PreviewRows}" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="60"/>
                                    <DataGridTemplateColumn Header="Result" Width="150">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Contact.DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Contact.Email}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Contact.Phone}" Width="*"/>
                                    <DataGridTextColumn Header="Company" Binding="{Binding Contact.CompanyName}" Width="*"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Message}" Width="1.6*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. import -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="5. Import" Style="{StaticResource Text.H2}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Import contacts" Style="{StaticResource Button.Primary}" Command="{Binding StartImportCommand}" IsEnabled="{Binding CanImport}" Padding="22,8"/>
                            <Button Content="Cancel import" Style="{StaticResource Button.Danger}" Command="{Binding CancelImportCommand}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Banner.Info}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.Status}" Value="Failed"><Setter Property="Background" Value="{DynamicResource Brush.ErrorBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Result.Status}" Value="Cancelled"><Setter Property="Background" Value="{DynamicResource Brush.WarningBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Result.Status}" Value="Completed"><Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                </Style.Triggers></Style></Border.Style>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Result.Status, StringFormat='Import {0}'}"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding Result.Imported, Mode=OneWay, StringFormat='{}{0:N0} imported'}"/><Run Text="  -  "/>
                                    <Run Text="{Binding Result.Duplicates, Mode=OneWay, StringFormat='{}{0:N0} duplicates'}"/><Run Text="  -  "/>
                                    <Run Text="{Binding Result.Failed, Mode=OneWay, StringFormat='{}{0:N0} failed'}"/><Run Text="  -  "/>
                                    <Run Text="{Binding Result.Proposed, Mode=OneWay, StringFormat='{}{0:N0} update proposals'}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Result.Error}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding Result.Error, Converter={StaticResource NullToVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="View contacts" Command="{Binding GoToContactsCommand}"/>
                                    <Button Content="Review duplicates" Command="{Binding GoToDuplicatesCommand}"/>
                                    <Button Content="Review update proposals" Command="{Binding GoToBulkUpdateCommand}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- history -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshHistoryCommand}" Margin="0"/><TextBlock Text="Import history" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock Text="No imports yet." Style="{StaticResource Text.Caption}" Visibility="{Binding History.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    <DataGrid ItemsSource="{Binding History}" MaxHeight="320" Visibility="{Binding History.Count, Converter={StaticResource CountToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.6*"/>
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, Converter={StaticResource UtcToLocal}}" Width="1.1*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/>
                            <DataGridTextColumn Header="Rows" Binding="{Binding TotalRows}" Width="0.6*"/>
                            <DataGridTextColumn Header="Imported" Binding="{Binding ImportedRows}" Width="0.7*"/>
                            <DataGridTextColumn Header="Duplicates" Binding="{Binding DuplicateRows}" Width="0.7*"/>
                            <DataGridTextColumn Header="Failed" Binding="{Binding FailedRows}" Width="0.6*"/>
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Report" Style="{StaticResource Button.Link}" Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
