<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CRM_Master</AssemblyName>
    <RootNamespace>CRM_Master.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>CRM MASTER</Company>
    <Description>CRM MASTER - Intelligent CRM Data Management and Automation Suite</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\SampleData\*.csv" Link="SampleData\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY.md" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="branding.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('branding.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <ProjectReference Include="..\CRM_Master.Core\CRM_Master.Core.csproj" />
    <ProjectReference Include="..\CRM_Master.Data\CRM_Master.Data.csproj" />
    <ProjectReference Include="..\CRM_Master.Engine\CRM_Master.Engine.csproj" />
    <ProjectReference Include="..\CRM_Master.Integrations\CRM_Master.Integrations.csproj" />
  </ItemGroup>
</Project>
