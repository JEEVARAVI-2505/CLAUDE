<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the app compile on Linux CI; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BuildingStudio</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="HelixToolkit.Core.Wpf" Version="2.27.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Studio.Pipeline\Studio.Pipeline.csproj" />
  </ItemGroup>
</Project>
