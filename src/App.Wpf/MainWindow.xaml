<Window x:Class="BuildingStudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:c="clr-namespace:BuildingStudio.App.Wpf.Controls"
        xmlns:vm="clr-namespace:BuildingStudio.App.Wpf.ViewModels"
        Title="AI Building Studio" Height="900" Width="1600" WindowState="Maximized">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Command="{Binding OpenCommand}"/>
            <Button Content="Save" Command="{Binding SaveCommand}"/>
            <Separator/>
            <Button Content="{Binding UndoText}" Command="{Binding UndoCommand}"/>
            <Button Content="Redo" Command="{Binding RedoCommand}"/>
            <Separator/>
            <TextBlock Text="Exterior style:" VerticalAlignment="Center" Margin="6,0,4,0"/>
            <ComboBox Width="120" ItemsSource="{x:Static vm:MainViewModel.StyleValues}" SelectedItem="{Binding Style}"/>
            <Separator/>
            <Button Content="Export drawings, BOQ, report, 3D…" Command="{Binding ExportAllCommand}" FontWeight="Bold"/>
            <Separator/>
            <TextBlock Text="{Binding Studio.Ai.Name, StringFormat='AI: {0}'}" VerticalAlignment="Center" Foreground="Gray" Margin="6,0"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="{Binding IsBusy}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: brief and options -->
            <TabControl Grid.Column="0">
                <TabItem Header="1 · Brief">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Style="{StaticResource Heading}" Text="Describe the house"/>
                            <TextBox Text="{Binding BriefText, UpdateSourceTrigger=PropertyChanged}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Parse brief" Command="{Binding ParseCommand}"/>
                                <ComboBox Width="190" ItemsSource="{Binding Presets}" SelectedIndex="{Binding SelectedPreset}" Margin="4,2"/>
                                <Button Content="Load" Command="{Binding LoadPresetCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BriefNotes}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="DarkSlateGray"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Heading}" Text="Confirm the brief"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Project"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Brief.ProjectName}"/>
                                <TextBlock Grid.Row="1" Text="Plot W x D (ft)"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="60" Text="{Binding Brief.PlotWidthFt}"/><TextBlock Text=" x "/><TextBox Width="60" Text="{Binding Brief.PlotDepthFt}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Facing / north°"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="60" ItemsSource="{x:Static vm:BriefViewModel.Sides}" SelectedItem="{Binding Brief.Facing}"/>
                                    <TextBox Width="50" Margin="6,0" Text="{Binding Brief.NorthAngleDeg}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="Floors (1 = G)"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="40" Text="{Binding Brief.Floors}"/><TextBlock Text="  height (m) "/><TextBox Width="50" Text="{Binding Brief.FloorHeightM}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="Vastu"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Brief.Vastu}" VerticalAlignment="Center"/>
                                    <ComboBox Width="110" Margin="6,0" ItemsSource="{x:Static vm:BriefViewModel.StrictnessValues}" SelectedItem="{Binding Brief.Strictness}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="5" Text="Style"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:BriefViewModel.StyleValues}" SelectedItem="{Binding Brief.Style}"/>
                                <TextBlock Grid.Row="6" Text="Setbacks F/R/S (m)"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="40" Text="{Binding Brief.FrontSetbackM}"/><TextBox Width="40" Margin="4,0" Text="{Binding Brief.RearSetbackM}"/>
                                    <TextBox Width="40" Text="{Binding Brief.SideSetbackM}"/>
                                    <Button Content="Bylaw" Command="{Binding ApplySetbacksCommand}" Padding="4,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="7" Text="Soil SBC / zone"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="50" Text="{Binding Brief.SoilSbc}"/><TextBlock Text=" kN/m²  zone "/><TextBox Width="30" Text="{Binding Brief.SeismicZone}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="8" Text="Car parks"/>
                                <TextBox Grid.Row="8" Grid.Column="1" Width="40" HorizontalAlignment="Left" Text="{Binding Brief.CarParks}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Heading}" Text="Rooms (sizes in feet, floor 0 = ground)"/>
                            <DataGrid ItemsSource="{Binding Brief.Rooms}" AutoGenerateColumns="False" CanUserAddRows="False" Height="230" HeadersVisibility="Column" x:Name="RoomsGrid">
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn Header="Type" Width="110" ItemsSource="{x:Static vm:BriefViewModel.RoomTypeValues}" SelectedItemBinding="{Binding Type}"/>
                                    <DataGridTextColumn Header="Fl" Width="30" Binding="{Binding Floor}"/>
                                    <DataGridTextColumn Header="Nos" Width="35" Binding="{Binding Count}"/>
                                    <DataGridTextColumn Header="W" Width="40" Binding="{Binding WidthFt}"/>
                                    <DataGridTextColumn Header="D" Width="40" Binding="{Binding DepthFt}"/>
                                    <DataGridCheckBoxColumn Header="Att. bath" Width="60" Binding="{Binding AttachedBath}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Room" Command="{Binding AddRoomCommand}"/>
                                <Button Content="− Selected" Command="{Binding RemoveRoomCommand}" CommandParameter="{Binding SelectedItem, ElementName=RoomsGrid}"/>
                                <Button Content="Check" Command="{Binding ValidateCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                            <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="Bold"/>: <Run Text="{Binding Message, Mode=OneWay}"/> <Run Text="{Binding Suggestion, Mode=OneWay}" Foreground="DarkGreen"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Generate plan options ▶" Command="{Binding GenerateCommand}" FontWeight="Bold" Height="34" Margin="0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="2 · Options">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply option" Command="{Binding ApplyOptionCommand}" FontWeight="Bold"/>
                                <Button Content="Compare costs" Command="{Binding CompareOptionsCommand}"/>
                                <Button Content="Re-solve around locks" Command="{Binding ResolveCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding OptionCosts}" Height="140" IsReadOnly="True" AutoGenerateColumns="True" Margin="0,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TradeOffs}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- CENTER: plan, 3D, structure, BOQ, drawings -->
            <TabControl Grid.Column="2">
                <TabItem Header="Plan editor">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <TextBlock Text="Floor:" VerticalAlignment="Center"/>
                            <ComboBox Width="60" Margin="4,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding CurrentLevel}"/>
                            <CheckBox Content="Vastu grid" IsChecked="{Binding ShowZones}" VerticalAlignment="Center" Margin="8,0"/>
                            <CheckBox Content="Furniture" IsChecked="{Binding ShowFurniture}" VerticalAlignment="Center"/>
                            <Button Content="Lock / unlock selected" Command="{Binding ToggleLockCommand}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="4">
                            <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyEditCommand}"/>
                            <TextBlock DockPanel.Dock="Left" Text="Edit in words:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" ToolTip="swap kitchen and store · move pooja to NE · make living 16x14 · lock kitchen"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="6,0" Foreground="Gray"
                                   Text="Drag a room onto another to swap · drag a wall to move it (neighbours adjust) · click to select · Ctrl+Z / Ctrl+Y"/>
                        <c:PlanCanvas x:Name="Plan"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="3D view">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <CheckBox Content="Furniture" IsChecked="{Binding ShowFurniture}" Margin="0,0,10,0"/>
                            <CheckBox Content="Structure (columns, beams, footings)" IsChecked="{Binding ShowStructure}" Margin="0,0,10,0"/>
                            <CheckBox Content="Cut away above current floor" IsChecked="{Binding FloorCut}"/>
                            <Button Content="Zoom to fit" Click="ZoomExtents_Click" Margin="10,0"/>
                        </StackPanel>
                        <h:HelixViewport3D x:Name="Viewport" ShowCoordinateSystem="True" ZoomExtentsWhenLoaded="True" Background="#DFE9F3" IsHeadLightEnabled="True">
                            <h:SunLight/>
                            <ModelVisual3D x:Name="SceneVisual"/>
                        </h:HelixViewport3D>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Structure">
                    <DockPanel Margin="6">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}">
                            <TextBlock Text="{Binding StructureBanner}" FontWeight="Bold" Foreground="#A04000" TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Model.Structure.Notes}"/>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Model.Structure.Warnings}" Foreground="Firebrick"/>
                        <TabControl>
                            <TabItem Header="Columns"><DataGrid ItemsSource="{Binding Model.Structure.Columns}" IsReadOnly="True"/></TabItem>
                            <TabItem Header="Beams"><DataGrid ItemsSource="{Binding Model.Structure.Beams}" IsReadOnly="True"/></TabItem>
                            <TabItem Header="Slabs"><DataGrid ItemsSource="{Binding Model.Structure.Slabs}" IsReadOnly="True"/></TabItem>
                            <TabItem Header="Footings"><DataGrid ItemsSource="{Binding Model.Structure.Footings}" IsReadOnly="True"/></TabItem>
                            <TabItem Header="Bar bending schedule"><DataGrid ItemsSource="{Binding Model.Structure.Bbs}" IsReadOnly="True"/></TabItem>
                        </TabControl>
                    </DockPanel>
                </TabItem>
                <TabItem Header="BOQ &amp; cost">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding CostText}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Report.Cost.Rates.Disclaimer}" Foreground="Gray" TextWrapping="Wrap"/>
                        <DataGrid DockPanel.Dock="Bottom" Height="200" ItemsSource="{Binding Report.Electrical}" IsReadOnly="True"/>
                        <DataGrid ItemsSource="{Binding Report.Cost.Lines}" IsReadOnly="True"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Drawings">
                    <DockPanel>
                        <ListBox DockPanel.Dock="Left" Width="220" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="Title"/>
                        <c:SheetView Sheet="{Binding SelectedSheet}"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

            <!-- RIGHT: live scores -->
            <DockPanel Grid.Column="4" Margin="6">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Vastu score" Foreground="Gray"/>
                    <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding Report.Vastu.Score, StringFormat={}{0:0}/100}"/>
                    <TextBlock Text="{Binding ComplianceText, StringFormat='Bylaws: {0}'}"/>
                    <TextBlock Text="{Binding CostText}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Heading}" Text="Selected room"/>
                    <TextBlock Text="{Binding SelectedRoomExplanation}" TextWrapping="Wrap"/>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Fixes">
                        <ItemsControl ItemsSource="{Binding Report.Fixes}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="Apply" Padding="6,0"
                                                Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="Areas"><DataGrid ItemsSource="{Binding Report.Areas}" IsReadOnly="True"/></TabItem>
                    <TabItem Header="Vastu">
                        <DockPanel>
                            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Report.Vastu.Rules}" DisplayMemberPath="Message"/>
                            <DataGrid ItemsSource="{Binding Report.Vastu.Rooms}" IsReadOnly="True"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Bylaws">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Report.Compliance.Disclaimer}" TextWrapping="Wrap" Foreground="#A04000"/>
                            <DataGrid ItemsSource="{Binding Report.Compliance.Items}" IsReadOnly="True"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Review">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="Write review notes" Command="{Binding ReviewCommand}"/>
                            <TextBox Text="{Binding ReviewNotes}" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
