<UserControl x:Class="LeadPilot.Desktop.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LeadPilot.Desktop.Views"
             xmlns:svc="clr-namespace:LeadPilot.Desktop.Services"
             svc:Motion.Enter="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26">
      <TextBlock Text="API Integrations" Style="{StaticResource H1}"/>
      <TextBlock Text="Data sources, optional AI and optional web search. The core app works without any paid service; keys you enter are stored encrypted for your Windows account." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
      <local:StatusBanner/>

      <TextBlock Text="Discovery sources" Style="{StaticResource H2}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding Providers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Content="Enabled" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                </DockPanel>
                <TextBlock Text="{Binding Type}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Cost}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding License}" Style="{StaticResource Muted}"/>
                <StackPanel Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="API key (stored encrypted; leave empty to keep the saved one)" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox Padding="10,8" svc:PasswordHelper.Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="A key is saved." Style="{StaticResource Muted}" Visibility="{Binding HasSavedKey, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="Custom server address (optional, e.g. your own Overpass server)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Endpoint}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Save" Command="{Binding DataContext.SaveProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  <Button Content="Test connection" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.TestProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="AI model (optional)" Style="{StaticResource H2}"/>
          <TextBlock Text="Off by default. Used only to polish drafts, summarise a company's own About text (as a suggestion) and understand unusual assistant questions." Style="{StaticResource Muted}"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding AiProvider}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Server address (blank = default)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AiEndpoint}"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Model name (blank = default)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AiModel}"/></StackPanel>
          </Grid>
          <TextBlock Text="Your API key (OpenAI-compatible only; stored encrypted)" Style="{StaticResource FieldLabel}"/>
          <PasswordBox Padding="10,8" svc:PasswordHelper.Password="{Binding AiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="A key is saved." Style="{StaticResource Muted}" Visibility="{Binding HasAiKey, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveAiCommand}"/>
            <Button Content="Test" Command="{Binding TestAiCommand}" Style="{StaticResource SecondaryButton}"/>
            <TextBlock Text="{Binding AiTestResult}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Website search (optional)" Style="{StaticResource H2}"/>
          <TextBlock Text="Brave Search API key (has a free tier). Lets Enrichment look for a company's official website when you have none on record." Style="{StaticResource Muted}"/>
          <PasswordBox Padding="10,8" Margin="0,8,0,0" svc:PasswordHelper.Password="{Binding BraveKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="A key is saved." Style="{StaticResource Muted}" Visibility="{Binding HasBraveKey, Converter={StaticResource BoolToVis}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveSearchKeyCommand}"/>
            <Button Content="Test" Command="{Binding TestSearchCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Remove key" Command="{Binding RemoveSearchKeyCommand}" Style="{StaticResource SecondaryButton}"/>
            <TextBlock Text="{Binding SearchTestResult}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Other sources" Style="{StaticResource H2}" Margin="0,12,0,8"/>
      <ItemsControl ItemsSource="{Binding Notes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
              <StackPanel>
                <TextBlock><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}" Margin="0,8,0,0" Background="{DynamicResource WarningSoftBrush}">
        <StackPanel>
          <TextBlock Text="What leaves this computer" Style="{StaticResource H2}"/>
          <TextBlock Text="{x:Static local:IntegrationsView.DisclosureText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Recent external requests" Style="{StaticResource H2}" Margin="0,24,0,8"/>
      <DataGrid ItemsSource="{Binding Usage}" MaxHeight="300">
        <DataGrid.Columns>
          <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130"/>
          <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="140"/>
          <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/>
          <DataGridTextColumn Header="Results" Binding="{Binding Results}" Width="80"/>
          <DataGridTextColumn Header="Outcome" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource CellText}"/>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
