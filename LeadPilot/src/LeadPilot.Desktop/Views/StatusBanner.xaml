<UserControl x:Class="LeadPilot.Desktop.Views.StatusBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:LeadPilot.Desktop.Services">
  <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    <Border svc:Motion.Show="True" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
    </Border>
    <Border svc:Motion.Show="True" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/>
    </Border>
  </StackPanel>
</UserControl>
