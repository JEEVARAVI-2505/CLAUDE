<UserControl x:Class="LeadPilot.Desktop.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LeadPilot.Desktop.Views"
             xmlns:svc="clr-namespace:LeadPilot.Desktop.Services"
             Style="{StaticResource Page}">
  <Grid Margin="32,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Clear chat" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Margin="0" VerticalAlignment="Top"/>
        <StackPanel>
          <TextBlock Text="AI Assistant" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
        </StackPanel>
      </DockPanel>
      <local:StatusBanner/>
      <ItemsControl ItemsSource="{Binding Examples}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" Style="{StaticResource SecondaryButton}" Padding="12,5" FontWeight="Normal" Margin="0,0,8,8"
                    Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource ChatBubble}">
              <StackPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Leads}" Margin="0,8,0,0" Visibility="{Binding HasLeads, Converter={StaticResource BoolToVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource GhostButton}" Padding="8,2" Margin="0"
                                Command="{Binding DataContext.OpenLeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <TextBlock>
                          <Run Text="{Binding LeadCode, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding CompanyName, Mode=OneWay}"/>
                          <Run Text="  -  score "/><Run Text="{Binding Score, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding Temperature, Mode=OneWay}"/><Run Text=")  "/>
                          <Run Text="{Binding Phone, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                        </TextBlock>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding DraftText}" TextWrapping="Wrap"/>
                </Border>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Run live search with these settings" Visibility="{Binding HasDiscovery, Converter={StaticResource BoolToVis}}" Padding="12,4"
                          Command="{Binding DataContext.RunDiscoveryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Discovery}"/>
                  <Button Content="Copy draft" Style="{StaticResource SecondaryButton}" Padding="12,4" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}"
                          Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding DraftText}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" Padding="22,9"/>
      <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ask about your leads, e.g. Show my top 20 prospects">
        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendCommand}"/></TextBox.InputBindings>
      </TextBox>
    </DockPanel>
  </Grid>
</UserControl>
