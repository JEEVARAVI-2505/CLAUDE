<UserControl x:Class="LeadPilot.Desktop.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LeadPilot.Desktop.Views"
             xmlns:svc="clr-namespace:LeadPilot.Desktop.Services"
             svc:Motion.Enter="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26">
      <TextBlock Text="Import Centre" Style="{StaticResource H1}"/>
      <TextBlock Text="Import leads from Excel (.xlsx) or CSV. Preview, map columns, validate, then confirm - duplicates are detected and a report is saved." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
      <local:StatusBanner/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="1. Choose a file" Style="{StaticResource H2}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Choose file…" Command="{Binding ChooseCommand}"/>
            <Button Content="Download sample CSV template" Command="{Binding SaveTemplateCommand}" Style="{StaticResource SecondaryButton}"/>
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          </StackPanel>
          <TextBlock Text="Old .xls files: open in Excel and use Save As .xlsx or CSV first." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding FileNote}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="2. Preview (first rows)" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="130" TextTrimming="CharacterEllipsis" Margin="0,2" Style="{StaticResource Muted}"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="3. Map columns" Style="{StaticResource H2}"/>
            <TextBlock Text="Columns were matched by name. Change any that are wrong; leave unwanted fields as (not mapped)." Style="{StaticResource Muted}" FontSize="11"/>
            <ItemsControl ItemsSource="{Binding Mapping}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Column}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="4. Validate" Command="{Binding ValidateCommand}"/>
              <Button Content="5. Confirm import" Command="{Binding ConfirmImportCommand}" IsEnabled="{Binding Validated}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0" MaxHeight="220">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="Import report" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource SuccessBrush}"/>
          <ItemsControl ItemsSource="{Binding ReportLines}" Margin="0,8,0,0" MaxHeight="240">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Open Lead Database" Command="{Binding GoDatabaseCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Previous imports" Style="{StaticResource H2}" Margin="0,24,0,8"/>
      <DataGrid ItemsSource="{Binding History}" MaxHeight="260">
        <DataGrid.Columns>
          <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150"/>
          <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*"/>
          <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="70"/>
          <DataGridTextColumn Header="Imported" Binding="{Binding Imported}" Width="90"/>
          <DataGridTextColumn Header="Duplicates" Binding="{Binding Duplicates}" Width="90"/>
          <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="70"/>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
