<Window x:Class="LeadPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:LeadPilot.Desktop.Services"
        svc:Motion.Enter="True"
        Title="LeadPilot AI" Width="1380" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Width="248" Background="{DynamicResource SidebarBrush}" Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,18">
          <Image Source="Assets/logo.png" Width="36" Height="36"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="LeadPilot AI" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Find · Qualify · Follow up" Foreground="{DynamicResource SidebarTextBrush}" FontSize="10.5"/>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource SidebarSelectedBrush}" BorderThickness="0,1,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Grid Width="36" Height="36">
                <Ellipse Fill="{DynamicResource PrimaryGradientBrush}"/>
                <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UserRole}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Switch user" Command="{Binding SwitchUserCommand}" Style="{StaticResource GhostButton}" Padding="0,4" Foreground="{DynamicResource SidebarTextBrush}"/>
              <Button Content="Dark / Light" Command="{Binding ToggleThemeCommand}" Style="{StaticResource GhostButton}" Padding="8,4" Foreground="{DynamicResource SidebarTextBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="26" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,8"
              Visibility="{Binding LicenseBanner, Converter={StaticResource HasValueToVis}}">
        <TextBlock Text="{Binding LicenseBanner}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
      </Border>
      <Grid Grid.Row="1">
        <ContentControl Content="{Binding CurrentPage}" IsTabStop="False"/>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,24,0" Background="{DynamicResource DangerBrush}" CornerRadius="12" Padding="12,4"
                Visibility="{Binding OverdueBanner, Converter={StaticResource HasValueToVis}}" IsHitTestVisible="False">
          <TextBlock Text="{Binding OverdueBanner}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
