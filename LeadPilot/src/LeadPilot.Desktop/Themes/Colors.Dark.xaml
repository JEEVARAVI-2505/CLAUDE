<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
  <SolidColorBrush x:Key="BgBrush" Color="#0B1020"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#141B31"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#19213A"/>
  <SolidColorBrush x:Key="LineBrush" Color="#26314F"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E7EBF6"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#98A4C2"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#5B8CFF"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7BA2FF"/>
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1B2850"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#070B16"/>
  <SolidColorBrush x:Key="SidebarTextBrush" Color="#B4C0D8"/>
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#18244A"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#2FC074"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F2B134"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#F06A6E"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1E"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12301F"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2D10"/>
  <SolidColorBrush x:Key="HotBrush" Color="#F2641A"/>
  <SolidColorBrush x:Key="WarmBrush" Color="#F2B134"/>
  <SolidColorBrush x:Key="ColdBrush" Color="#3B82F6"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4670"/>
  <Color x:Key="PrimaryColor">#5B8CFF</Color>
  <Color x:Key="PrimaryColor2">#9B7BFF</Color>
  <SolidColorBrush x:Key="NoneBrush" Color="#98A2B8"/>
  <!-- make stock controls follow the theme -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141B31"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7EBF6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C2542"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7EBF6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#26314F"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#2E3A5E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#4A5780"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#98A4C2"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6C7897"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D6FE8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#223263"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E7EBF6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#141B31"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E7EBF6"/>
</ResourceDictionary>
