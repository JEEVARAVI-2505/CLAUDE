<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:LeadPilot.Desktop.Services"
                    xmlns:vm="clr-namespace:LeadPilot.Application.ViewModels;assembly=LeadPilot.Application"
                    xmlns:views="clr-namespace:LeadPilot.Desktop.Views">

  <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
  <conv:InverseBoolConverter x:Key="InverseBool"/>
  <conv:HasValueToVisibilityConverter x:Key="HasValueToVis"/>
  <conv:NameToBrushConverter x:Key="NameToBrush"/>
  <conv:FractionToStarConverter x:Key="FracStar"/>
  <conv:ScoreToStarConverter x:Key="ScoreStar"/>

  <!-- view-model -> view -->
  <DataTemplate DataType="{x:Type vm:SetupViewModel}"><views:SetupView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:LeadFinderViewModel}"><views:LeadFinderView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:LeadDatabaseViewModel}"><views:LeadDatabaseView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:LeadDetailsViewModel}"><views:LeadDetailsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:DuplicateManagerViewModel}"><views:DuplicateManagerView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:EnrichmentViewModel}"><views:EnrichmentView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:QualificationViewModel}"><views:QualificationView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:FollowUpViewModel}"><views:FollowUpView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:CampaignViewModel}"><views:CampaignView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}"><views:AnalyticsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:AssistantViewModel}"><views:AssistantView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ImportViewModel}"><views:ImportView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ExportViewModel}"><views:ExportView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:IntegrationsViewModel}"><views:IntegrationsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView/></DataTemplate>
  <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView/></DataTemplate>

  <!-- horizontal bar chart (default for ChartData) -->
  <DataTemplate DataType="{x:Type vm:ChartData}">
    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
        <TextBlock Text="No data yet" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Bars}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Height="12" Margin="8,0">
                  <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracStar}}"/>
                      <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracStar}, ConverterParameter=rest}"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6"/>
                  </Grid>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- vertical column chart (explicit: ContentTemplate="{StaticResource ColumnChart}") -->
  <DataTemplate x:Key="ColumnChart" DataType="{x:Type vm:ChartData}">
    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
        <TextBlock Text="No data yet" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Bars}" Height="170" Margin="0,12,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                <Grid Grid.Row="1">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Fraction, Converter={StaticResource FracStar}, ConverterParameter=rest}"/>
                    <RowDefinition Height="{Binding Fraction, Converter={StaticResource FracStar}}"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
